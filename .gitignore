# .NET
bin/
obj/
*.user
*.suo
[Dd]ebug/
[Rr]elease/
artifacts/
*.nupkg
.vs/
project.lock.json
TestResults/
coverage/
*.trx
*.coverage
*.cobertura.xml

# Node / frontend
# Matches a node_modules DIRECTORY and a node_modules SYMLINK. The trailing slash used to be here, and
# git treats a symlink as a file, so a linked dependency tree was staged by `git add -A`.
node_modules
dist/
.vite/
*.local
.eslintcache
playwright-report/
.playwright/

# Env & secrets — NEVER commit plaintext secrets (use OpenBao + SOPS)
.env
*.env
# Timestamped .env backups written by the local-dev key-rotation flow (e.g. .env.bak.prekongfix.*) —
# same secrets as .env itself, so the same rule: never in history.
.env.bak.*
!*.env.example
!.env.example
*.pem
*.key
!*.pub
.secrets/
!*.sops.yaml

# IaC state — never commit (remote backend per ADR-0002)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
tofu.plan
*.tfplan

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# Local tool installs
/.dotnet/
/dotnet-install.sh

# Logs & scratch
*.log
/tmp/
/scratch/

# Windows/WSL metadata
*:Zone.Identifier
*Zone.Identifier
