<Project>

  <!--
    Solution-wide MSBuild defaults for every Mersal HBMP .NET project.
    Applied automatically to all Api/Domain/Infrastructure/Tests projects.
    See CLAUDE.md § Naming & conventions (nullable, warnings-as-errors, langversion).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Quality gates: warnings are errors; analyzers on. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Deterministic, reproducible builds (supply-chain / CI parity). -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Central Package Management (versions live in Directory.Packages.props). -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Test projects opt into coverage collection and relax analyzer rules that fight
       idiomatic xUnit style (underscored Method_Scenario_Expectation names, inline arrays,
       and micro-perf rules that don't matter in tests). -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <CollectCoverage>true</CollectCoverage>
    <NoWarn>$(NoWarn);CA1707;CA1861;CA1859;CA1515;CA2007;CA1861;CA1305;CA1822;CA1861</NoWarn>
  </PropertyGroup>

</Project>
