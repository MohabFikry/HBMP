<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework/Nullable/ImplicitUsings come from Directory.Build.props. -->
  <PropertyGroup>
    <RootNamespace>Mersal.Auth</RootNamespace>
    <AssemblyName>Mersal.Auth</AssemblyName>
  </PropertyGroup>

  <!-- Needs ASP.NET Core types (authentication/authorization/DI/http). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <!-- The Tests/ subfolder is its own project; keep it out of the library's compile glob. -->
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <None Remove="Tests/**/*" />
  </ItemGroup>

</Project>
