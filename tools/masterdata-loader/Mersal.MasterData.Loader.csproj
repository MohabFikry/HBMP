<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mersal.MasterData.Loader</RootNamespace>
    <AssemblyName>masterdata-loader</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../services/masterdata/Domain/Mersal.MasterData.Domain.csproj" />
    <ProjectReference Include="../../services/masterdata/Infrastructure/Mersal.MasterData.Infrastructure.csproj" />
    <ProjectReference Include="../../libs/audit-client/Mersal.Audit.Client.csproj" />
    <ProjectReference Include="../../libs/prescribing/Mersal.Prescribing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 31.3 — the measurements the drug workbook omits, read at load time. Copied rather than embedded so a
         pharmacist can open it, and so correcting a value does not need a rebuild. -->
    <None Include="data/pack-measurement-overrides.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
</Project>
