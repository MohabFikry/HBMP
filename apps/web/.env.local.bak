# Local dev — LIVE mode against the Compose stack.
#
# With NO such file the SPA runs in fixture mode (DevAuthClient + DevApiClient). That is fine for most
# portals, which read through the injected `ApiClient` and therefore have fixtures — but the Phase 19 policy
# and membership screens go through `src/api/policyApi.ts` → `http.ts`, which always makes a real request.
# In fixture mode they are the only screens with no data source, so they render empty while everything else
# looks populated.
#
# Not committed (.gitignore) — this is machine-local.

VITE_LIVE=1

# Kong. The gateway now validates the issuer's RS256 signature at the edge, so an unauthenticated call is
# rejected here rather than at the service.
VITE_API_BASE=http://localhost:8000/api/v1

# identity-service (OpenIddict), NOT Keycloak — Phase 17 / ADR-0015 retired the realm.
VITE_OIDC_AUTHORITY=http://localhost:8090
VITE_OIDC_CLIENT_ID=hbmp-web
VITE_OIDC_REDIRECT=http://localhost:5173/
