# Mersal HBMP — web SPA runtime configuration (Vite reads VITE_* at build/dev time).
# Copy to `.env.local` and adjust. With NO file present the app runs in fixture mode
# (DevAuthClient + DevApiClient, no backend) — the default for local dev and tests.

# --- Mode -------------------------------------------------------------------
# "1" = LIVE mode: authenticate via Keycloak (auth-code + PKCE) and call the real
# services through Kong. Anything else (or unset) = fixture mode.
VITE_LIVE=0

# --- API gateway ------------------------------------------------------------
# Base URL of the Kong gateway; every service call is `${VITE_API_BASE}/<path>`.
VITE_API_BASE=http://localhost:8000/api/v1

# --- OIDC (Keycloak) --------------------------------------------------------
# Realm issuer as the BROWSER reaches it — must match the token `iss` claim.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/mersal
VITE_OIDC_CLIENT_ID=hbmp-web
VITE_OIDC_REDIRECT=http://localhost:5173/
