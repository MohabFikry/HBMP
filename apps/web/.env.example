# Mersal HBMP — web SPA runtime configuration (Vite reads VITE_* at build/dev time).
# Copy to `.env.local` and adjust. With NO file present the app runs in fixture mode
# (DevAuthClient + DevApiClient, no backend) — the default for local dev and tests.

# --- Mode -------------------------------------------------------------------
# "1" = LIVE mode: authenticate against the in-app issuer (identity-service —
# ASP.NET Identity + OpenIddict, ADR-0015) with auth-code + PKCE, and call the
# real services through Kong. Anything else (or unset) = fixture mode.
#
# This file said KEYCLOAK until 28.2, and pointed at a realm URL that has not
# existed since phase 17. It told every developer who opened it that their
# credentials went somewhere they no longer do — the same defect LoginPage.tsx
# records having carried in its user-facing copy.
VITE_LIVE=0

# --- One origin (ADR-0036 §4) -----------------------------------------------
# The SPA, the API and the issuer share ONE origin. In development the Vite dev
# server proxies /api, /connect, /.well-known and /identity to the gateway; in
# the deployed image the app's own nginx does the same. So these are RELATIVE,
# and the browser resolves them against whatever origin served the page.
#
# Keeping them relative is also what keeps the session cookie working: the
# issuer's Identity cookies are SameSite=Strict, so a cross-origin login POST
# has its cookie dropped by the browser — the sign-in succeeds and the next
# authorize reports login_required, which reads as "wrong password".
#
# `tools/ci/check-login-origin.py` fails the build if these drift apart.
VITE_API_BASE=/api/v1

# --- OIDC (the in-app issuer) -----------------------------------------------
# Blank = the app's own origin. Set it only when the issuer is genuinely
# elsewhere, and then everything above has to move with it.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=hbmp-web
# The one value that stays ABSOLUTE: it is sent as `redirect_uri` and compared
# byte-for-byte against the client registered with the issuer.
VITE_OIDC_REDIRECT=http://localhost:5173/
