{
  "uid": "mersal-golden-signals",
  "title": "Mersal — Golden Signals (per service)",
  "tags": ["mersal", "sre", "golden-signals"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_server_request_duration_seconds_count, job)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1, "title": "Latency p95 (s) — NFR-001 bar 1.5s", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1.5 } ] } } },
      "targets": [ { "datasource": "Prometheus", "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le, job))", "legendFormat": "{{job}} p95" } ]
    },
    {
      "id": 2, "title": "Traffic (req/s)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [ { "datasource": "Prometheus", "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$job\"}[5m])) by (job)", "legendFormat": "{{job}}" } ]
    },
    {
      "id": 3, "title": "Errors (5xx rate)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [ { "datasource": "Prometheus", "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$job\",http_response_status_code=~\"5..\"}[5m])) by (job) / sum(rate(http_server_request_duration_seconds_count{job=~\"$job\"}[5m])) by (job)", "legendFormat": "{{job}} error ratio" } ]
    },
    {
      "id": 4, "title": "Saturation (CPU seconds/s + GC)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(process_cpu_seconds_total{job=~\"$job\"}[5m])", "legendFormat": "{{job}} cpu" },
        { "datasource": "Prometheus", "expr": "sum(rate(process_runtime_dotnet_gc_collections_count{job=~\"$job\"}[5m])) by (job)", "legendFormat": "{{job}} gc" }
      ]
    }
  ]
}
