# Mersal HBMP — Tier 1 Compose environment (STARTER)
# Copy to `.env` and replace every value. NEVER commit the real .env.
# For production, move these into OpenBao and inject via the app, not a flat file.

# --- PostgreSQL ---
POSTGRES_USER=hbmp
POSTGRES_PASSWORD=change-me-strong-db-pass

# --- identity-service (in-app OIDC issuer, Phase 17 — replaced Keycloak) ---
# Secret for the confidential service-to-service client (hbmp-services, client-credentials).
IDENTITY_SERVICE_SECRET=change-me-strong-service-secret
# 18.B1: demo staff accounts (one per role) are seeded ONLY when Issuer__SeedDemoUsers is on.
# There is no default — the seeder fails fast without this, so no image ships a known password.
IDENTITY_DEMO_PASSWORD=change-me-dev-demo-password

# --- MinIO (S3 object storage) root ---
MINIO_ROOT_USER=hbmp-minio
MINIO_ROOT_PASSWORD=change-me-strong-minio-pass

# --- RabbitMQ ---
RABBITMQ_USER=hbmp
RABBITMQ_PASSWORD=change-me-strong-rmq-pass

# --- Valkey (cache) ---
VALKEY_PASSWORD=change-me-strong-valkey-pass

# --- OpenSearch ---
OPENSEARCH_ADMIN_PASSWORD=Change-Me-Strong-OS-Pass1!
# Secure by default (compose falls back to false). Set to "true" ONLY for a throwaway local dev box;
# never with real data. Leave unset/false everywhere else and configure TLS/users.
OPENSEARCH_DISABLE_SECURITY=false

# --- OpenBao (secrets/KMS) — dev root token, STARTER only ---
OPENBAO_ROOT_TOKEN=change-me-dev-root-token

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-grafana-pass

# --- Image tag for app services (when you add them) ---
TAG=latest

# hbmp_app NOBYPASSRLS runtime DB role password (set out of band; OpenBao secret/hbmp/db/app).
# 18.B2: EVERY service now connects as a non-superuser. Without these two the stack will not start.
HBMP_APP_PASSWORD=
# audit-service's OWN login role (member of hbmp_audit_writer only) — deliberately not hbmp_app, so
# the shared runtime role cannot read the audit trail. OpenBao secret/hbmp/db/audit.
HBMP_AUDIT_PASSWORD=
