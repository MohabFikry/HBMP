{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "http://identity-service:8080",
    "Audience": "hbmp-api",
    "ProtectedScopeRequiresMfa": true
  },
  "Emr": {
    "BaseUrl": "http://emr-service:8080"
  },
  "Document": {
    "BaseUrl": "http://document-service:8080"
  },
  "Approvals": {
    "Sla": {
      "EmergencyHours": 1,
      "UrgentHours": 4,
      "RoutineHours": 48
    }
  },
  "Events": {
    "RabbitUri": "amqp://guest:guest@rabbitmq:5672",
    "Queues": []
  }
}
