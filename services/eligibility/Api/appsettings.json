{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "http://identity-service:8080",
    "Audience": "hbmp-api",
    "ProtectedScopeRequiresMfa": true
  },
  "Cache": {
    "Valkey": ""
  },
  "Events": {
    "RabbitUri": "amqp://guest:guest@rabbitmq:5672",
    "Queues": [
      "patient.events",
      "policy.events"
    ]
  }
}
