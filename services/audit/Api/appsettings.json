{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "http://keycloak:8080/realms/mersal",
    "Audience": "hbmp-api",
    "RequireHttpsMetadata": false,
    "ProtectedScopeRequiresMfa": true
  },
  "ConnectionStrings": {
    "Audit": "Host=postgres;Database=hbmp;Username=hbmp;Password=change-me-strong-db-pass"
  },
  "Worm": {
    "Endpoint": "http://minio:9000",
    "AccessKey": "hbmp-minio",
    "SecretKey": "change-me-strong-minio-pass",
    "Bucket": "hbmp-audit-worm",
    "RetentionDays": 3650
  },
  "Messaging": {
    "Uri": "amqp://hbmp:change-me-strong-rmq-pass@rabbitmq:5672",
    "Queue": "audit.events"
  }
}
