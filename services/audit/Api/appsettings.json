{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "http://identity-service:8080",
    "Audience": "hbmp-api",
    "ProtectedScopeRequiresMfa": true
  },
  "Worm": {
    "Endpoint": "http://minio:9000",
    "AccessKey": "hbmp-minio",
    "SecretKey": "change-me-strong-minio-pass",
    "Bucket": "hbmp-audit-worm",
    "RetentionDays": 3650
  },
  "Messaging": {
    "Uri": "amqp://hbmp:change-me-strong-rmq-pass@rabbitmq:5672",
    "Queue": "audit.events"
  }
}
