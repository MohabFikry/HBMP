{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "http://identity-service:8080",
    "Audience": "hbmp-api",
    "ProtectedScopeRequiresMfa": true
  },
  "Notification": {
    "EnableSms": false,
    "EnableWhatsApp": false,
    "MaxEmailAttempts": 4,
    "RetryBaseSeconds": 30
  },
  "Events": {
    "RabbitUri": "amqp://guest:guest@rabbitmq:5672",
    "Queues": []
  }
}
